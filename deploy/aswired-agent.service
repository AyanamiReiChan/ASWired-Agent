[Unit]
Description=ASWired Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aswired-agent -config /etc/aswired-agent/agent.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
